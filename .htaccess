# ============================================================
# .htaccess - salairebrutonet.com
# HTTPS redirect, security headers, gzip compression, caching
# ============================================================

# --- Force HTTPS ---
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Force www to non-www ---
RewriteCond %{HTTP_HOST} ^www\.salairebrutonet\.com [NC]
RewriteRule ^(.*)$ https://salairebrutonet.com/$1 [R=301,L]

# --- Security Headers ---
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions policy
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    # Strict Transport Security (1 year)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    # Content Security Policy (allows Clarity analytics)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://www.clarity.ms https://*.clarity.ms;"
</IfModule>

# --- Gzip Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# --- Browser Caching ---
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML - short cache (content changes)
    ExpiresByType text/html "access plus 1 hour"

    # CSS & JS
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # JSON / Manifest
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/manifest+json "access plus 1 day"
    ExpiresByType application/ld+json "access plus 1 day"

    # Default
    ExpiresDefault "access plus 1 month"
</IfModule>

# --- UTF-8 Charset ---
AddDefaultCharset UTF-8

# --- Prevent directory listing ---
Options -Indexes

# --- 301 Redirects: removed content pages → homepage ---
# All *-euros-brut-en-net/ pages (all removed)
RewriteRule ^[0-9]+-euros-brut-en-net(/.*)?$ / [R=301,L]

# All *-euros-net-en-brut/ pages EXCEPT the 5 kept ones
RewriteCond %{REQUEST_URI} !^/1500-euros-net-en-brut(/.*)?$
RewriteCond %{REQUEST_URI} !^/1900-euros-net-en-brut(/.*)?$
RewriteCond %{REQUEST_URI} !^/3300-euros-net-en-brut(/.*)?$
RewriteCond %{REQUEST_URI} !^/4400-euros-net-en-brut(/.*)?$
RewriteCond %{REQUEST_URI} !^/5000-euros-net-en-brut(/.*)?$
RewriteRule ^[0-9]+-euros-net-en-brut(/.*)?$ / [R=301,L]

# All salaire-brut-net-* pages EXCEPT interim
RewriteCond %{REQUEST_URI} !^/salaire-brut-net-interim(/.*)?$
RewriteRule ^salaire-brut-net-[a-z].*$ / [R=301,L]

# Individual removed pages
RewriteRule ^13eme-mois-brut-net(/.*)?$ / [R=301,L]
RewriteRule ^avantages-en-nature(/.*)?$ / [R=301,L]
RewriteRule ^calculateur-cout-employeur(/.*)?$ / [R=301,L]
RewriteRule ^calculateur-heures-supplementaires(/.*)?$ / [R=301,L]
RewriteRule ^calculateur-temps-partiel(/.*)?$ / [R=301,L]
RewriteRule ^cotisations-sociales-salariales(/.*)?$ / [R=301,L]
RewriteRule ^cout-employeur(/.*)?$ / [R=301,L]
RewriteRule ^difference-salaire-brut-net(/.*)?$ / [R=301,L]
RewriteRule ^glossaire(/.*)?$ / [R=301,L]
RewriteRule ^heures-supplementaires-brut-net(/.*)?$ / [R=301,L]
RewriteRule ^lire-fiche-de-paie(/.*)?$ / [R=301,L]
RewriteRule ^negocier-salaire(/.*)?$ / [R=301,L]
RewriteRule ^salaire-moyen-france(/.*)?$ / [R=301,L]
RewriteRule ^salaire-net-avant-apres-impot(/.*)?$ / [R=301,L]
RewriteRule ^salaire-net-imposable(/.*)?$ / [R=301,L]
RewriteRule ^simulateur-augmentation(/.*)?$ / [R=301,L]
RewriteRule ^smic-brut-net-2026(/.*)?$ / [R=301,L]
RewriteRule ^taux-horaire-brut-net(/.*)?$ / [R=301,L]
RewriteRule ^tous-les-salaires(/.*)?$ / [R=301,L]

# --- Custom error page ---
ErrorDocument 404 /404.html
